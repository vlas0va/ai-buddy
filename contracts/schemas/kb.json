{
  "server": "kb",
  "tools": [
    {
      "name": "search",
      "description": "Поиск по базе знаний среди документов, доступных роли и команде пользователя (ACL до LLM). Все документы — тестовые.",
      "roles": [
        "intern",
        "mentor",
        "lead",
        "hrbp",
        "alumni"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "doc_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "source_type": {
                  "const": "test"
                },
                "url": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              },
              "required": [
                "doc_id",
                "title",
                "snippet",
                "source_type"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "add_faq",
      "description": "Добавить ответ наставника в базу знаний его команды (сценарий S2, флаг escalation_to_kb). Документ виден ролям intern, mentor, lead этой команды.",
      "roles": [
        "mentor"
      ],
      "write": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "body": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8000
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "= proposal_id; repeated call returns stored result"
          },
          "confirmation_token": {
            "type": "string",
            "description": "Issued by core on user confirmation; see contracts/mcp-tools.md"
          }
        },
        "required": [
          "title",
          "body",
          "idempotency_key",
          "confirmation_token"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "const": "test"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "doc_id",
          "title",
          "source_type"
        ]
      }
    }
  ]
}
