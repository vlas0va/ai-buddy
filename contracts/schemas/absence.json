        "intern",
        "mentor",
        "lead"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_type": {
            "const": "test"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "title",
          "text",
          "source_type"
        ]
      }
    },
    {
      "name": "list_my_requests",
      "description": "Заявки на отсутствие текущего пользователя.",
      "roles": [
        "intern",
        "mentor",
        "lead"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending_approval",
              "pending_hr",
              "approved",
              "rejected",
              "cancelled"
            ],
            "description": "pending_hr = the lead approved, the HR admin has not decided yet (dates can still be moved)"
          }
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ABS-[0-9]{6}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "day_off",
                    "vacation",
                    "absence",
                    "parental_leave"
                  ],
                  "description": "day_off = отгул, vacation = отпуск, absence = отсутствие, parental_leave = декрет"
                },
                "start_date": {
                  "type": "string",
                  "format": "date"
                },
                "end_date": {
                  "type": "string",
                  "format": "date"
                },
                "comment": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending_approval",
                    "pending_hr",
                    "approved",
                    "rejected",
                    "cancelled"
                  ],
                  "description": "pending_hr = the lead approved, the HR admin has not decided yet (dates can still be moved)"
                },
                "approver_id": {
                  "type": "string"
                },
                "approver_display_name": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "documents": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "mime": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "name"
                    ]
                  },
                  "description": "Metadata of attached documents (never their content)"
                },
                "steps": {
                  "type": "array",
                  "description": "Lead approves, HR admin registers in the HR system, HR BP is notified",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "lead",
                          "hr_admin",
                          "hrbp"
                        ]
                      },
                      "display_name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "waiting",
                          "approved",
                          "rejected",
                          "registered",
                          "notified",
                          "skipped"
                        ]
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "role",
                      "status"
                    ]
                  }
                },
                "replayed": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "type",
                "start_date",
                "end_date",
                "status",
                "approver_id",
                "created_at"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "validate_request",
      "description": "Проверка без записи по виду: отгул — рабочие дни, до 3 дней; отпуск — за 14 дней, до 28 дней; отсутствие — до 5 дней; декрет — нужен документ. Нет пересечений.",
      "roles": [
        "intern",
        "mentor",
        "lead"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "day_off",
              "vacation",
              "absence",
              "parental_leave"
            ],
            "description": "day_off = отгул, vacation = отпуск, absence = отсутствие, parental_leave = декрет"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "documents": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 200
                },
                "mime": {
                  "type": "string",
                  "maxLength": 100
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name"
              ]
            },
            "description": "Metadata of attached documents (never their content)"
          },
          "exclude_id": {
            "type": "string",
            "pattern": "^ABS-[0-9]{6}$",
            "description": "the request being moved"
          }
        },
        "required": [
          "type",
          "start_date",
          "end_date"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approver_id": {
            "type": "string"
          },
          "approver_display_name": {
            "type": "string"
          }
        },
        "required": [
          "valid",
          "problems"
        ]
      }
    },
    {
      "name": "create_request",
