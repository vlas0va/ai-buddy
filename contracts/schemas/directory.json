{
  "server": "directory",
  "tools": [
    {
      "name": "whoami",
      "description": "Профиль пользователя из JWT: команда, роль, начало стажировки, текущий период.",
      "roles": [
        "intern",
        "mentor",
        "lead",
        "hrbp",
        "alumni",
        "hr_admin"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "team_name": {
            "type": "string"
          },
          "cohort_start": {
            "type": "string",
            "format": "date"
          },
          "current_period": {
            "type": "string",
            "enum": [
              "week_1",
              "week_2",
              "month_1",
              "month_2",
              "after_3_months"
            ]
          }
        },
        "required": [
          "employee_id",
          "display_name",
          "role",
          "team_id"
        ]
      }
    },
    {
      "name": "get_my_contacts",
      "description": "Свои наставник, руководитель, HR BP и куратор стажировки и с чем к ним идти.",
      "roles": [
        "intern",
        "mentor",
        "lead",
        "hrbp",
        "alumni",
        "hr_admin"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "mentor",
                    "lead",
                    "hrbp",
                    "curator"
                  ]
                },
                "employee_id": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "channel": {
                  "type": "string",
                  "description": "Название канала или чата, без личных контактов"
                },
                "ask_about": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "role",
                "employee_id",
                "display_name"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  ]
}
