{
  "server": "access",
  "tools": [
    {
      "name": "list_required",
      "description": "Доступы, нужные команде пользователя (Confluence, Jira, пространство кластера/команды), со статусом для него.",
      "roles": [
        "intern",
        "mentor"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resource_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "tool",
                    "space",
                    "channel",
                    "project",
                    "repo",
                    "database"
                  ]
                },
                "elevated": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "not_requested",
                    "pending_approval",
                    "granted",
                    "rejected"
                  ]
                },
                "checklist_item_id": {
                  "type": "string"
                },
                "environments": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "dev",
                      "stage",
                      "prod"
                    ]
                  },
                  "description": "empty = the resource has no environments"
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write",
                      "admin"
                    ],
                    "description": "чтение, запись, администрирование"
                  }
                },
                "optional": {
                  "type": "boolean",
                  "description": "requested on demand, not part of the onboarding checklist"
                },
                "approver_label": {
                  "type": "string",
                  "description": "who approves write/admin/prod rights"
                },
                "environment": {
                  "type": "string",
                  "enum": [
                    "dev",
                    "stage",
                    "prod"
                  ]
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "admin"
                  ],
                  "description": "чтение, запись, администрирование"
                }
              },
              "required": [
                "resource_id",
                "name",
                "kind",
                "elevated",
                "status"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
