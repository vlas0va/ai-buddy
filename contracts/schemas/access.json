    {
      "name": "list_team_channels",
      "description": "Каналы и чаты команды (только названия и назначение, без участников).",
      "roles": [
        "intern",
        "mentor"
      ],
      "write": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "closed": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "closed"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "request_access",
      "description": "Заявка на доступ для пользователя из JWT: конкретный ресурс (проект Jira, репозиторий, БД), окружение и уровень прав. Запись, администрирование и prod уходят на согласование руководителю.",
      "roles": [
        "intern",
        "mentor"
      ],
      "write": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev",
              "stage",
              "prod"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ],
            "description": "чтение, запись, администрирование",
            "default": "read"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "= proposal_id; repeated call returns stored result"
          },
          "confirmation_token": {
            "type": "string",
            "description": "Issued by core on user confirmation; see contracts/mcp-tools.md"
          }
        },
        "required": [
          "resource_id",
          "idempotency_key",
          "confirmation_token"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ACC-[0-9]{6}$"
          },
          "resource_id": {
            "type": "string"
          },
          "resource_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_approval",
              "granted",
              "rejected"
            ]
          },
          "approver_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checklist_item_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plan task to link the action to (R66)"
          },
          "environment": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "dev",
              "stage",
              "prod",
              null
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ],
            "description": "чтение, запись, администрирование"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "resource_id",
          "status",
          "created_at"
        ]
      }
    }
  ]
}
