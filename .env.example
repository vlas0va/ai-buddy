# AI-buddy configuration example. Copy to .env; never commit real values.

# LLM: stub works without any key and passes all scenarios.
LLM_PROVIDER=stub            # stub | openai_compat
LLM_BASE_URL=                # any OpenAI-compatible endpoint, e.g. https://<provider>/v1 or http://ollama:11434/v1
LLM_API_KEY=                 # organizers can put their own key here
LLM_MODEL=                   # model name at that provider
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.2
LLM_TOOL_CALLING=false       # true: the LLM may call READ tools of the user's role (never write tools)
LLM_FALLBACK_TO_STUB=true    # on LLM failure answer with the stub instead of an error
EMBEDDINGS_BASE_URL=         # optional hybrid retrieval, e.g. http://ollama:11434/v1 (model bge-m3)
EMBEDDINGS_MODEL=

# Optional own-compute A-Vibe (compose profile avibe, docs/llm-and-keys.md)
HF_TOKEN=                    # Hugging Face token, only if the model download asks for one
AVIBE_MAX_LEN=8192           # context length for vLLM
# AVIBE_QUANTIZATION_FLAG=--quantization=fp8

# Core
CORE_PORT=8080
JWT_SECRET=change-me-local-only
CONFIRMATION_HMAC_SECRET=change-me-local-only
POSTGRES_URL=postgres://buddy:buddy@postgres:5432/buddy?sslmode=disable
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=               # empty = Kafka off; make up-full sets kafka:9092 (compose ignores this file's value)
CORS_ORIGINS=http://localhost:5173   # comma-separated web origins allowed to call core
JWT_TTL=12h                  # lifetime of the login token
CHAT_RATE_PER_MIN=20         # chat messages per user per minute (Redis)
CRON_INTERVAL=24h            # AI-cron period; POST /api/cron/run runs it now (demo build)
CORE_HOST_PORT=8080          # host port of core in compose (change VITE_API_BASE_URL and CORS_ORIGINS with it)
WEB_HOST_PORT=5173           # host port of web in compose
AGENT_HOST_PORT=8090         # host port of the agent in compose (debug only)

# MCP servers (owner B): one binary mcp-mocks, six servers at http://mcp-mocks:8100/mcp/<server>
MCP_MOCKS_PORT=8100
KB_DIR=/app/data/kb          # knowledge base loaded into kb.documents at start (volume ../data/kb)
TEST_DATABASE_URL=           # Go tests: Postgres superuser URL; empty = scripts/test-db.sh starts one on 127.0.0.1:55432

# Agent (owner A, services/agent)
AGENT_PORT=8090
AGENT_CONFIG=/app/agent.yaml
AGENT_URL=http://agent:8090  # how core reaches the agent
AGENT_SERVICE_TOKEN=         # optional shared secret core → agent (header X-Service-Token)
AGENT_DEV_MODE=false         # true: /dev console with test logins (never for the jury stack)
AGENT_ALLOW_CLOCK_OVERRIDE=false
MOCK_FAULTS=                 # demo of R79, e.g. absence.create_request=timeout_after:1
# MCP servers of B (all eight in one binary mcp-mocks). compose sets MCP_BASE_URL=http://mcp-mocks:8100/mcp for core and
# the agent; empty (make agent-dev, agent tests) = the agent's in-process mock of that server.
MCP_BASE_URL=                # http://mcp-mocks:8100/mcp  → every server at <base>/<server>
MCP_ABSENCE_URL=             # per-server override, e.g. http://mcp-mocks:8100/mcp/absence
MCP_APPROVALS_URL=
MCP_DIRECTORY_URL=
MCP_CHECKLIST_URL=
MCP_ACCESS_URL=
MCP_KB_URL=
MCP_TRIPS_URL=
MCP_CONSENTS_URL=
# Web search for general technical questions outside the KB (only the masked question leaves the agent)
WEB_SEARCH_PROVIDER=curated  # curated (official docs list, offline) | searxng (live, profile websearch) | off
WEB_SEARCH_URL=              # searxng only, e.g. http://searxng:8080
SEARXNG_SECRET=              # searxng only; compose has a local-only default

# Web (build time)
VITE_API_BASE_URL=http://localhost:8080
VITE_FEATURE_DEBUG_PANEL=false
