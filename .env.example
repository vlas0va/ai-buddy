# AI-buddy configuration example. Copy to .env; never commit real values.

# LLM: stub works without any key and passes all scenarios.
# stub | openai_compat
LLM_PROVIDER=stub
# any OpenAI-compatible endpoint, e.g. https://<provider>/v1 or http://ollama:11434/v1
LLM_BASE_URL=
# organizers can put their own key here
LLM_API_KEY=
# model name at that provider
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.2
# true: the LLM may call READ tools of the user's role (never write tools)
LLM_TOOL_CALLING=false
# on LLM failure answer with the stub instead of an error
LLM_FALLBACK_TO_STUB=true
# reasoning models (A-Vibe/Qwen3): ask for no <think> and cut it out of answers
LLM_NO_THINK=true
# A-Vibe on the laptop GPU through Ollama (docs/llm-and-keys.md):
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=hf.co/NightForger/avibe-GGUF:Q4_K_M
#   LLM_TIMEOUT_S=90
# optional hybrid retrieval, e.g. http://ollama:11434/v1 (model bge-m3)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# Optional own-compute A-Vibe (compose profile avibe, docs/llm-and-keys.md)
# Hugging Face token, only if the model download asks for one
HF_TOKEN=
# context length for vLLM
AVIBE_MAX_LEN=8192
# AVIBE_QUANTIZATION_FLAG=--quantization=fp8

# Core
CORE_PORT=8080
JWT_SECRET=change-me-local-only
CONFIRMATION_HMAC_SECRET=change-me-local-only
POSTGRES_URL=postgres://buddy:buddy@postgres:5432/buddy?sslmode=disable
REDIS_URL=redis://redis:6379/0
# empty = Kafka off; make up-full sets kafka:9092 (compose ignores this file's value)
KAFKA_BROKERS=
# comma-separated web origins allowed to call core
CORS_ORIGINS=http://localhost:5173
# lifetime of the login token
JWT_TTL=12h
# chat messages per user per minute (Redis)
CHAT_RATE_PER_MIN=20
# AI-cron period; POST /api/cron/run runs it now (demo build)
CRON_INTERVAL=24h
# host port of core in compose (change VITE_API_BASE_URL and CORS_ORIGINS with it)
CORE_HOST_PORT=8080
# host port of web in compose
WEB_HOST_PORT=5173
# host port of the agent in compose (debug only)
AGENT_HOST_PORT=8090

# MCP servers (owner B): one binary mcp-mocks, six servers at http://mcp-mocks:8100/mcp/<server>
MCP_MOCKS_PORT=8100
# knowledge base: compose sets KB_DIR per container (mcp-mocks /app/data/kb, agent /data/kb); set it here only for
# running a service outside Docker, e.g. KB_DIR=./data/kb
# KB_DIR=
# Go tests: Postgres superuser URL; empty = scripts/test-db.sh starts one on 127.0.0.1:55432
TEST_DATABASE_URL=

# Agent (owner A, services/agent)
AGENT_PORT=8090
AGENT_CONFIG=/app/agent.yaml
# how core reaches the agent
AGENT_URL=http://agent:8090
# optional shared secret core → agent (header X-Service-Token)
AGENT_SERVICE_TOKEN=
# true: /dev console with test logins (never for the jury stack)
AGENT_DEV_MODE=false
AGENT_ALLOW_CLOCK_OVERRIDE=false
# demo of R79, e.g. absence.create_request=timeout_after:1
MOCK_FAULTS=
# MCP servers of B (all eight in one binary mcp-mocks). compose sets MCP_BASE_URL=http://mcp-mocks:8100/mcp for core and
# the agent; empty (make agent-dev, agent tests) = the agent's in-process mock of that server.
# http://mcp-mocks:8100/mcp  → every server at <base>/<server>
MCP_BASE_URL=
# per-server override, e.g. http://mcp-mocks:8100/mcp/absence
MCP_ABSENCE_URL=
MCP_APPROVALS_URL=
MCP_DIRECTORY_URL=
MCP_CHECKLIST_URL=
MCP_ACCESS_URL=
MCP_KB_URL=
MCP_TRIPS_URL=
MCP_CONSENTS_URL=
# Web search for general technical questions outside the KB (only the masked question leaves the agent)
# curated (official docs list, offline) | searxng (live, profile websearch) | off
WEB_SEARCH_PROVIDER=curated
# searxng only, e.g. http://searxng:8080
WEB_SEARCH_URL=
# searxng only; compose has a local-only default
SEARXNG_SECRET=

# Web (build time)
VITE_API_BASE_URL=http://localhost:8080
VITE_FEATURE_DEBUG_PANEL=false
