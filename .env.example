# Пример конфигурации AI-buddy. Скопируйте в .env; реальные значения никогда не коммитьте.

# LLM: stub работает без ключа и проходит все сценарии.
# stub | openai_compat
# пусто — A-Vibe во встроенной Ollama (по умолчанию в compose, stub, пока она загружается); stub — без модели вообще
LLM_PROVIDER=
# любой OpenAI-совместимый эндпоинт, например https://<provider>/v1 или http://ollama:11434/v1
LLM_BASE_URL=
# организаторы могут вписать сюда свой ключ
LLM_API_KEY=
# имя модели у этого провайдера
LLM_MODEL=
# пусто — 120 с для A-Vibe во встроенной Ollama (на CPU медленно; после таймаута на 5 минут включается stub)
LLM_TIMEOUT_S=
LLM_TEMPERATURE=0.2
# true: LLM может вызывать инструменты ЧТЕНИЯ роли пользователя (никогда инструменты записи)
LLM_TOOL_CALLING=false
# при сбое LLM отвечать через stub, а не ошибкой
LLM_FALLBACK_TO_STUB=true
# модели с рассуждениями (A-Vibe/Qwen3): просить без <think> и вырезать его из ответов
LLM_NO_THINK=true
# A-Vibe на GPU ноутбука через Ollama (docs/llm-and-keys.md):
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=hf.co/NightForger/avibe-GGUF:Q4_K_M
#   LLM_TIMEOUT_S=90
# необязательный гибридный поиск, например http://ollama:11434/v1 (модель bge-m3)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# Необязательная A-Vibe на своих мощностях (профиль compose avibe, docs/llm-and-keys.md)
# токен Hugging Face, только если скачивание модели его просит
HF_TOKEN=
# длина контекста для vLLM
AVIBE_MAX_LEN=8192
# AVIBE_QUANTIZATION_FLAG=--quantization=fp8

# Ядро
CORE_PORT=8080
JWT_SECRET=change-me-local-only
CONFIRMATION_HMAC_SECRET=change-me-local-only
POSTGRES_URL=postgres://buddy:buddy@postgres:5432/buddy?sslmode=disable
REDIS_URL=redis://redis:6379/0
# пусто — Kafka выключена; make up-full ставит kafka:9092 (compose игнорирует значение из этого файла)
KAFKA_BROKERS=
# origin веба через запятую, которым разрешено обращаться к ядру
CORS_ORIGINS=http://localhost:5173
# время жизни токена входа
JWT_TTL=12h
# сообщений чата на пользователя в минуту (Redis)
CHAT_RATE_PER_MIN=20
# период AI-cron; POST /api/cron/run запускает его сейчас (демо-сборка)
CRON_INTERVAL=24h
# порт ядра на хосте в compose (меняйте вместе с ним VITE_API_BASE_URL и CORS_ORIGINS)
CORE_HOST_PORT=8080
# порт веба на хосте в compose
WEB_HOST_PORT=5173
# порт агента на хосте в compose (только для отладки)
AGENT_HOST_PORT=8090

# MCP-серверы (владелец B): один бинарник mcp-mocks, шесть серверов по http://mcp-mocks:8100/mcp/<server>
MCP_MOCKS_PORT=8100
# база знаний: compose задаёт KB_DIR для каждого контейнера (mcp-mocks /app/data/kb, агент /data/kb); задавайте здесь
# только
# для запуска сервиса вне Docker, например KB_DIR=./data/kb
# KB_DIR=
# Go-тесты: URL суперпользователя Postgres; пусто — scripts/test-db.sh поднимает его на 127.0.0.1:55432
TEST_DATABASE_URL=

# Агент (владелец A, services/agent)
AGENT_PORT=8090
AGENT_CONFIG=/app/agent.yaml
# как ядро обращается к агенту
AGENT_URL=http://agent:8090
# необязательный общий секрет ядро → агент (заголовок X-Service-Token)
AGENT_SERVICE_TOKEN=
# true: консоль /dev с тестовыми входами (никогда для стека жюри)
AGENT_DEV_MODE=false
AGENT_ALLOW_CLOCK_OVERRIDE=false
# демо R79, например absence.create_request=timeout_after:1
MOCK_FAULTS=
# MCP-серверы B (все восемь в одном бинарнике mcp-mocks). compose задаёт MCP_BASE_URL=http://mcp-mocks:8100/mcp для ядра
# и агента; пусто (make agent-dev, тесты агента) — мок этого сервера в процессе агента.
# http://mcp-mocks:8100/mcp  → каждый сервер по <base>/<server>
MCP_BASE_URL=
# переопределение для сервера, например http://mcp-mocks:8100/mcp/absence
MCP_ABSENCE_URL=
MCP_APPROVALS_URL=
MCP_DIRECTORY_URL=
MCP_CHECKLIST_URL=
MCP_ACCESS_URL=
MCP_KB_URL=
MCP_TRIPS_URL=
MCP_CONSENTS_URL=
# Веб-поиск по общим техническим вопросам вне базы знаний (из агента уходит только замаскированный вопрос)
# curated (список официальной документации, без сети) | searxng (живой, профиль websearch) | off
WEB_SEARCH_PROVIDER=curated
# только для searxng, например http://searxng:8080
WEB_SEARCH_URL=
# только для searxng; в compose есть значение по умолчанию только для локальной работы
SEARXNG_SECRET=

# Веб (на этапе сборки)
VITE_API_BASE_URL=http://localhost:8080
VITE_FEATURE_DEBUG_PANEL=false
