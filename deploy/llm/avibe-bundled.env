# Default: nothing to set. Compose runs Ollama with A-Vibe (hf.co/NightForger/avibe-GGUF:Q4_K_M, ~5 GB, downloaded on the
# first start) and passes LLM_DEFAULT_* to the agent. Keep the LLM_* lines below empty (or delete them) in .env.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=
# NVIDIA GPU: docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.gpu.yml --profile core up -d --build --wait
