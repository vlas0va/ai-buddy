# По умолчанию: ничего задавать не нужно. Compose запускает Ollama с A-Vibe (hf.co/NightForger/avibe-GGUF:Q4_K_M, ~5 ГБ,
# скачивается при первом запуске) и передаёт агенту LLM_DEFAULT_*. Строки LLM_* ниже оставьте в .env пустыми (или удалите).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=
# GPU NVIDIA: docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.gpu.yml --profile core up -d --build --wait
