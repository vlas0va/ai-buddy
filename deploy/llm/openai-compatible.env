# Any OpenAI-compatible cloud API (POST {LLM_BASE_URL}/chat/completions, streaming). The organizers put their key here.
# Examples of LLM_BASE_URL / LLM_MODEL:
#   OpenAI:      https://api.openai.com/v1            gpt-4o-mini
#   OpenRouter:  https://openrouter.ai/api/v1         openai/gpt-4o-mini
#   YandexGPT / GigaChat / others through an OpenAI-compatible proxy: the proxy URL and its model name
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<key from the organizers>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
# true: the model may call READ tools of the user's role (never write tools); needs tool calling at the provider
LLM_TOOL_CALLING=false
# reasoning tags are cut out anyway; false for non-reasoning models
LLM_NO_THINK=false
