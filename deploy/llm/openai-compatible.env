# Любой OpenAI-совместимый облачный API (POST {LLM_BASE_URL}/chat/completions, потоковый). Организаторы вписывают сюда свой ключ.
# Примеры LLM_BASE_URL / LLM_MODEL:
#   OpenAI:      https://api.openai.com/v1            gpt-4o-mini
#   OpenRouter:  https://openrouter.ai/api/v1         openai/gpt-4o-mini
#   YandexGPT / GigaChat / другие через OpenAI-совместимый прокси: URL прокси и имя модели у него
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<key from the organizers>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
# true: модель может вызывать инструменты ЧТЕНИЯ роли пользователя (никогда инструменты записи); нужен вызов инструментов у провайдера
LLM_TOOL_CALLING=false
# теги рассуждений вырезаются в любом случае; false для моделей без рассуждений
LLM_NO_THINK=false
