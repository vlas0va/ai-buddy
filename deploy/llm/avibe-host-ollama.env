# A-Vibe в Ollama, установленной на хосте (Windows/macOS/Linux): сначала `ollama pull hf.co/NightForger/avibe-GGUF:Q4_K_M`.
# Windows: setx OLLAMA_HOST 0.0.0.0 и перезапустите Ollama, чтобы контейнеры могли до неё достучаться.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=hf.co/NightForger/avibe-GGUF:Q4_K_M
LLM_TIMEOUT_S=90
LLM_NO_THINK=true
