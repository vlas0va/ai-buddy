# A-Vibe in Ollama installed on the host (Windows/macOS/Linux): first `ollama pull hf.co/NightForger/avibe-GGUF:Q4_K_M`.
# Windows: setx OLLAMA_HOST 0.0.0.0 and restart Ollama, so the containers can reach it.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=hf.co/NightForger/avibe-GGUF:Q4_K_M
LLM_TIMEOUT_S=90
LLM_NO_THINK=true
