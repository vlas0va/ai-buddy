    {
      "id": 4,
      "type": "stat",
      "title": "Действия, успешные с первой попытки",
      "description": "action.created с attempt=1 к сумме action.created и action.failed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "buddy-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0 * count(*) FILTER (WHERE name='action.created' AND COALESCE((props->>'attempt')::int,1)=1) / NULLIF(count(*) FILTER (WHERE name IN ('action.created','action.failed')),0), 0) AS value FROM core.analytics_events WHERE $__timeFilter(ts)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
