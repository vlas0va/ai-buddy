  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Обращения к наставнику на стажёра в неделю",
      "description": "chat.escalated / число стажёров, по неделям",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "buddy-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', ts) AS time, count(*)::float / GREATEST((SELECT count(*) FROM core.users WHERE role='intern'),1) AS \"эскалаций на стажёра\"\nFROM core.analytics_events WHERE name='chat.escalated' AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Доля вопросов без эскалации",
      "description": "chat.answered / (chat.answered + chat.escalated)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "buddy-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0 * a / NULLIF(a + e, 0), 0) AS value FROM (SELECT count(*) FILTER (WHERE name='chat.answered') AS a, count(*) FILTER (WHERE name='chat.escalated') AS e FROM core.analytics_events WHERE $__timeFilter(ts)) t",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
